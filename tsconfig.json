{
  "compilerOptions": {
    "target": "es2021",
    "module": "NodeNext",
    "declaration": true,
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "NodeNext",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "declarationMap": true,
    "noEmit": true,
    "resolveJsonModule": true,
  //   "baseUrl": ".",
  //   "paths": {
  //     "@backend-src/*": ["packages/backend/src/*"],
  //     "@backend-tests/*": ["packages/backend/tests/*"],
  //     "@backend-common/*": ["packages/backend/src/common/*"]
  //   }
  },
  "include": ["packages/*/src", "packages/*/tests"],
  "exclude": ["node_modules", "dist", "packages/*/node_modules", "packages/*/dist"]
}
