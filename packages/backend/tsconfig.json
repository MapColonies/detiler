{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
      "rootDir": ".",
      "outDir": "dist",
      "module": "nodenext",
      "moduleResolution": "nodenext",
      "baseUrl": ".",
      "paths": {
        "@src/*": ["src/*"],
        "@common/*": ["src/common/*"],
        "@tests/*": ["tests/*"]
      }
    },
    "include": ["src", "tests"]
}
