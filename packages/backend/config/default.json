{
  "openapiConfig": {
    "filePath": "./openapi3.yaml",
    "basePath": "/docs",
    "rawPath": "/api",
    "uiPath": "/api"
  },
  "telemetry": {
    "tracing": {
      "isEnabled": false
    },
    "metrics": {
      "enabled": false
    },
    "shared": {},
    "logger": {
      "level": "info",
      "prettyPrint": false
    }
  },
  "server": {
    "port": 8080,
    "request": {
      "payload": {
        "limit": "1mb"
      }
    },
    "response": {
      "compression": {
        "enabled": true,
        "options": null
      }
    }
  },
  "redis": {
    "host": "localhost",
    "port": 6379,
    "username": "",
    "password": "",
    "tls": {
      "enabled": false,
      "ca": "",
      "key": "",
      "cert": ""
    },
    "dbIndex": 0
  }
}
