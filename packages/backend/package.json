{
  "name": "detiler-backend",
  "version": "1.3.0",
  "description": "detiler backend service",
  "main": "./src/index.ts",
  "scripts": {
    "test:unit": "jest --config=./tests/configurations/unit/jest.config.js",
    "format": "prettier --check . --ignore-path ../../.prettierignore",
    "format:fix": "prettier --write . --ignore-path ../../.prettierignore",
    "prelint:fix": "npm run format:fix",
    "prelint": "npm run format",
    "lint:openapi": "openapi lint ./openapi3.yaml",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "tsc --noEmit && npm run test:unit",
    "prebuild": "npm run clean",
    "build": "tsc --project tsconfig.build.json && tsc-alias -p tsconfig.build.json && npm run assets:copy",
    "start": "npm run build && cd dist && node --import ./instrumentation.mjs ./index.js",
    "start:dev": "npm run build && cd dist && cross-env CONFIG_OFFLINE_MODE=true  node --enable-source-maps --import ./instrumentation.mjs ./index.js",
    "assets:copy": "copyfiles -f ./config/* ./dist/config && copyfiles -f ./openapi3.yaml ./dist/ && copyfiles ./package.json dist",
    "clean": "rimraf dist",
    "generate:openapi-types": "openapi-helpers ./openapi3.yaml ./src/openapi.d.ts --format --add-typed-request-handler"
  },
  "directories": {
    "test": "tests"
  },
  "author": "MapColonies",
  "license": "ISC",
  "dependencies": {
    "@godaddy/terminus": "^4.12.1",
    "@map-colonies/cleanup-registry": "^1.1.0",
    "@map-colonies/config": "^1.3.2",
    "@map-colonies/detiler-common": "^1.3.0",
    "@map-colonies/error-express-handler": "^3.0.0",
    "@map-colonies/express-access-log-middleware": "^3.0.1",
    "@map-colonies/js-logger": "^2.0.0",
    "@map-colonies/openapi-express-viewer": "^4.0.0",
    "@map-colonies/read-pkg": "^1.0.0",
    "@map-colonies/schemas": "^1.3.0",
    "@map-colonies/telemetry": "^7.0.1",
    "@map-colonies/tile-calc": "^0.1.5",
    "@opentelemetry/api": "^1.7.0",
    "@opentelemetry/api-metrics": "^0.29.0",
    "@opentelemetry/instrumentation-express": "0.32.1",
    "@opentelemetry/instrumentation-http": "0.35.0",
    "@turf/turf": "^7.1.0",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "express": "^4.21.2",
    "express-openapi-validator": "^5.4.7",
    "http-status-codes": "^2.3.0",
    "mime-types": "^2.1.35",
    "prom-client": "^15.1.2",
    "redis": "^4.6.12",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.8.0",
    "wellknown": "^0.5.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^18.4.4",
    "@map-colonies/commitlint-config": "^1.1.1",
    "@map-colonies/eslint-config": "^6.0.0",
    "@map-colonies/openapi-helpers": "^2.0.0",
    "@map-colonies/prettier-config": "0.0.1",
    "@map-colonies/standard-version-update-helm-version": "^2.0.1",
    "@map-colonies/standard-version-update-openapi3-version": "0.0.2",
    "@map-colonies/tsconfig": "^1.0.1",
    "@redocly/cli": "^1.34.0",
    "@redocly/openapi-cli": "^1.0.0-beta.94",
    "@swc/core": "^1.11.11",
    "@swc/jest": "^0.2.37",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/geojson": "7946.0.14",
    "@types/jest": "^29.5.14",
    "@types/mime-types": "^2.1.4",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.5.1",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/wellknown": "^0.5.8",
    "commitlint": "^17.6.6",
    "copyfiles": "^2.4.1",
    "cross-env": "^7.0.3",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^9.23.0",
    "eslint-plugin-jest": "^28.11.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-create-mock-instance": "^2.0.0",
    "jest-html-reporters": "^3.1.4",
    "jest-openapi": "^0.14.2",
    "prettier": "^3.5.3",
    "pretty-quick": "^4.1.1",
    "rimraf": "^6.0.1",
    "standard-version": "^9.5.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.2.6",
    "tsc-alias": "^1.8.11",
    "typescript": "^5.8.3"
  }
}
