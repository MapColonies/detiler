CONFIG_LOG_LEVEL=debug
CONFIG_LOG_PRETTY_PRINT_ENABLED=true

CONFIG_APP_BASEMAP_ENABLED=true
CONFIG_APP_BASEMAP_URL=https://tiles-int.mapcolonies.net/api/raster/v1/wmts/VIVID_IRAN-Orthophoto/WorldCRS84/{z}/{x}/{y}.jpeg
CONFIG_APP_BASEMAP_TILE_SIZE=256
CONFIG_APP_BASEMAP_ZOOM_OFFSET=0
CONFIG_APP_BASEMAP_DESATURATE=0
# requires an api key - put CONFIG_APP_BASEMAP_XAPIKEY=<key> in a gitignored config/.env.development.local instead of here
CONFIG_APP_UI_TILES_PER_PAGE=5
CONFIG_APP_DATA_ALPHA_CHANNEL=75
CONFIG_APP_KITS_FETCH_INTERVAL=60000
CONFIG_APP_TILES_BATCH_SIZE=1000
CONFIG_APP_TILES_FETCH_TIMEOUT=5000
CONFIG_APP_TILES_FETCH_INTERVAL=5000

CONFIG_DETILER_CLIENT_URL=http://localhost:8080
CONFIG_DETILER_CLIENT_TIMEOUT=60000
CONFIG_DETILER_CLIENT_ENABLE_RETRY_STRATEGY=false
